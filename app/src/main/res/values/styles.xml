<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StarTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/star_bg</item>
        <item name="android:statusBarColor">@color/star_bg</item>
        <item name="android:navigationBarColor">@color/star_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="StarDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
